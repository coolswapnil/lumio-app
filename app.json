{
  "expo": {
    "name": "Lumio",
    "slug": "lumio-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "lumio",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "extra": {
      "logo": {
        "light": "./assets/logo-light.png",
        "dark": "./assets/logo-dark.png"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumio.savelater"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.lumio.savelater",
      "versionCode": 10000,
      "targetSdkVersion": 35,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "lumio" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Lumio",
      "shortName": "Lumio",
      "themeColor": "#0f172a",
      "backgroundColor": "#0f172a"
    },
    "plugins": [
      "./plugins/withEdgeToEdge",
      "./plugins/withNativeShare",
      "./plugins/withShareBridge",
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Lumio to use your location to tag saved content with GPS coordinates."
        }
      ],
      [
        "expo-secure-store"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
